rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Entries: owner can read/write, authenticated users can read shared entries
    match /entries/{entryId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow read: if request.auth != null
        && resource.data.visibility == 'shared';
      allow write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Friends: only the owner can read/write their own friends
    match /friends/{friendId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Invites: anyone can read (needed for invite link flow), owner can create/write
    match /invites/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow write: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Push notification subscribers: authenticated users can subscribe,
    // only Cloud Functions (admin SDK) read/delete
    match /pushSubscribers/{tokenId} {
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['userId', 'token', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.token is string;
    }
  }
}
